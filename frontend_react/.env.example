# Recipe Explorer Frontend Environment Variables
# Copy this file to .env and fill in your values

# Site URL for redirects (used by Supabase auth)
REACT_APP_SITE_URL=http://localhost:3000

# API Endpoints (if backend is implemented)
REACT_APP_API_URL=http://localhost:8000/api

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_SOCIAL_LOGIN=false

# App Configuration
REACT_APP_NAME="Recipe Explorer"
REACT_APP_VERSION=1.0.0

# External Services (future integrations)
# REACT_APP_SUPABASE_URL=your_supabase_url
# REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
# REACT_APP_GOOGLE_ANALYTICS_ID=your_google_analytics_id
